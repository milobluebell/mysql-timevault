MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_PASSWORD=replace-with-a-long-random-backup-password
MYSQL_RESTORE_ROOT_PASSWORD=replace-with-another-long-random-password
MYSQL_DATABASE=app
# For a MySQL 8.0 source, set MYSQL_IMAGE=mysql:8.0.
# MYSQL_IMAGE=mysql:8.0
# Match the restore target to the source major version.
# MYSQL_RESTORE_IMAGE=mysql:5.7
MYSQL_USER=mm_agent
MYSQL_SLOW_QUERY_SECONDS=2
# Host paths for the MySQL data, backup data, and config file bind mounts.
MYSQL_STORAGE_DIR=./storage/mysql
MM_STORAGE_DIR=./mm-storage
MM_CONFIG_FILE=./mm-storage/mm-config.yaml
# Used only with compose.restore.yaml; must be an empty, separate directory.
MYSQL_RESTORE_STORAGE_DIR=./storage/mysql-restore
# For Linux bind-mount permissions, set these to `id -u` and `id -g`.
MM_UID=1000
MM_GID=1000
