# Choose a tag matching the host CPU: 0.1.0-amd64 or 0.1.0-arm64.
MM_IMAGE=milobluebell/mysql-timevault:0.1.0-amd64
MYSQL_PASSWORD=replace-with-a-long-random-backup-password
# Host paths for backup data and config file bind mounts.
MM_STORAGE_DIR=./mm-storage
MM_CONFIG_FILE=./mm-storage/mm-config.yaml
# Used only by compose.with-mysql.yaml; defaults to ./storage.
# MYSQL_STORAGE_DIR=./storage
# For Linux bind-mount permissions, set these to `id -u` and `id -g`.
MM_UID=1000
MM_GID=1000
# If MySQL is in another Compose project, set both variables below.
# MYSQL_DOCKER_NETWORK=existing_mysql_network
# COMPOSE_FILE=compose.yaml:compose.network.yaml
